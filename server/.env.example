PORT=3001
DB_PORT=5432
DATABASE_URL=postgresql://laprevia:laprevia@localhost:5432/laprevia
# Claves de 32 bytes en base64. npm run setup las genera al crear el .env
CLAVE_CIFRADO=
CLAVE_HASH=
DOMINIO_CORPORATIVO=laprevia.pe
# Proxies de confianza delante de la API: 1 en local (Next); en AWS, el balanceador y Next (2).
# Con el valor correcto, una IP falsa que mande el visitante en X-Forwarded-For no se toma en cuenta.
SALTOS_PROXY=1
# Inicios de sesión permitidos desde una IP cada 15 minutos (por defecto 20).
LIMITE_INICIOS_POR_IP=20
# Peticiones a la API permitidas por minuto desde una IP (por defecto 100).
LIMITE_GENERAL_POR_MINUTO=100
# Hojas del Libro de Reclamaciones permitidas por hora desde una IP (por defecto 10).
LIMITE_HOJAS_POR_HORA=10
# Correo del servicio. Fuera de producción (NODE_ENV distinto de production) se usa Mailpit (docker compose) en localhost:1025,
# con su bandeja en http://localhost:8025, y estas variables pueden quedar vacías.
# En producción son obligatorias: servidor SMTP del proveedor (p. ej. Amazon SES), sus credenciales
# y el remitente con un dominio verificado en ese proveedor. La conexión exige TLS.
SMTP_SERVIDOR=
SMTP_PUERTO=
SMTP_USUARIO=
SMTP_CONTRASENA=
CORREO_REMITENTE=
CORREO_WEB_PUERTO=8025
