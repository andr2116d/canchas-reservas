generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// Enums

enum Rol {
  ADMINISTRADOR
  RECEPCIONISTA
  JUGADOR
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
}

enum TipoDocumento {
  DNI
  CE
}

enum MotivoAcceso {
  OK
  CREDENCIALES
  INACTIVO
}

enum TamanoCancha {
  FUTBOL_5
  FUTBOL_7
}

enum EstadoCancha {
  OPERATIVA
  EN_MANTENIMIENTO
}

enum Franja {
  DIA
  NOCHE
}

enum TipoCompensacion {
  DEVOLUCION
  CREDITO
}

enum EstadoReserva {
  PENDIENTE_PAGO
  PENDIENTE_VALIDACION
  CONFIRMADA
  EN_JUEGO
  FINALIZADA
  CANCELADA
  EXPIRADA
  AUSENTE
}

enum OrigenReserva {
  PLATAFORMA
  RECEPCION
}

enum ConceptoPago {
  ADELANTO
  SALDO
  ADICIONALES
}

enum CanalPago {
  RECEPCION
  ONLINE
}

enum MetodoPago {
  EFECTIVO
  YAPE
  PLIN
  TRANSFERENCIA
  TARJETA
  CREDITO
}

enum EstadoPago {
  EN_PROCESO
  PENDIENTE_VALIDACION
  APROBADO
  RECHAZADO
}

enum MotivoCancelacion {
  CLIENTE
  INCIDENCIA
}

enum ResultadoCancelacion {
  SIN_COMPENSACION
  DEVOLUCION
  CREDITO
  RETENCION
}

enum EstadoCompensacion {
  NO_APLICA
  PENDIENTE
  PARCIAL
  ATENDIDA
}

enum ResultadoCierre {
  SOBRANTE
  FALTANTE
  SIN_DIFERENCIA
}

// Acceso y usuarios

model Usuario {
  id              Int           @id @default(autoincrement())
  nombres         String
  apellidos       String?
  tipoDocumento   TipoDocumento @map("tipo_documento")
  numeroDocumento String        @map("numero_documento")
  correo          String?       @unique
  telefono        String
  passwordHash    String?       @map("password_hash")
  rol             Rol           @default(JUGADOR)
  estado          EstadoUsuario @default(ACTIVO)
  creadoPorId     Int?          @map("creado_por_id")
  creadoEn        DateTime      @default(now()) @map("creado_en")
  actualizadoEn   DateTime      @updatedAt @map("actualizado_en")

  creadoPor           Usuario?            @relation("UsuarioCreadoPor", fields: [creadoPorId], references: [id])
  usuariosCreados     Usuario[]           @relation("UsuarioCreadoPor")
  tokensRecuperacion  TokenRecuperacion[]
  accesos             RegistroAcceso[]
  auditorias          Auditoria[]
  tarifas             Tarifa[]
  bloqueos            Bloqueo[]
  reservas            Reserva[]           @relation("ReservaJugador")
  reservasCreadas     Reserva[]           @relation("ReservaCreadaPor")
  pagosRegistrados    Pago[]              @relation("PagoRegistradoPor")
  pagosValidados      Pago[]              @relation("PagoValidadoPor")
  consumos            ConsumoAdicional[]
  cancelaciones       Cancelacion[]
  devoluciones        Devolucion[]
  creditos            Credito[]           @relation("CreditoJugador")
  creditosHabilitados Credito[]           @relation("CreditoHabilitadoPor")
  reubicaciones       Reubicacion[]
  cierres             CierreCaja[]
  correccionesCaja    CorreccionCaja[]

  @@unique([tipoDocumento, numeroDocumento])
  @@index([rol, estado])
  @@index([telefono])
  @@map("usuario")
}

model TokenRecuperacion {
  id        Int       @id @default(autoincrement())
  usuarioId Int       @map("usuario_id")
  tokenHash String    @unique @map("token_hash")
  expiraEn  DateTime  @map("expira_en")
  usadoEn   DateTime? @map("usado_en")
  creadoEn  DateTime  @default(now()) @map("creado_en")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("token_recuperacion")
}

model RegistroAcceso {
  id        Int          @id @default(autoincrement())
  usuarioId Int?         @map("usuario_id")
  correo    String
  exito     Boolean
  motivo    MotivoAcceso
  ip        String?
  fecha     DateTime     @default(now())

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([usuarioId, fecha])
  @@map("registro_acceso")
}

model Auditoria {
  id        Int      @id @default(autoincrement())
  fecha     DateTime @default(now())
  usuarioId Int?     @map("usuario_id")
  accion    String
  entidad   String
  entidadId Int?     @map("entidad_id")
  motivo    String?
  detalle   Json?

  usuario Usuario? @relation(fields: [usuarioId], references: [id])

  @@index([fecha])
  @@index([usuarioId, fecha])
  @@index([accion, fecha])
  @@index([entidad, entidadId])
  @@map("auditoria")
}

// Configuración del complejo

model Cancha {
  id            Int          @id @default(autoincrement())
  nombre        String
  tamano        TamanoCancha
  iluminacion   Boolean
  estado        EstadoCancha @default(OPERATIVA)
  activa        Boolean      @default(true)
  creadoEn      DateTime     @default(now()) @map("creado_en")
  actualizadoEn DateTime     @updatedAt @map("actualizado_en")

  tarifas            Tarifa[]
  bloqueos           Bloqueo[]
  reservas           Reserva[]
  reubicacionesDesde Reubicacion[] @relation("ReubicacionCanchaAnterior")
  reubicacionesHacia Reubicacion[] @relation("ReubicacionCanchaNueva")

  @@map("cancha")
}

model Tarifa {
  id           Int       @id @default(autoincrement())
  canchaId     Int       @map("cancha_id")
  franja       Franja
  valor        Decimal   @db.Decimal(10, 2)
  vigenteDesde DateTime  @default(now()) @map("vigente_desde")
  vigenteHasta DateTime? @map("vigente_hasta")
  creadoPorId  Int       @map("creado_por_id")

  cancha    Cancha  @relation(fields: [canchaId], references: [id])
  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])

  @@index([canchaId, franja, vigenteHasta])
  @@map("tarifa")
}

model HorarioDia {
  diaSemana Int     @id @map("dia_semana")
  abierto   Boolean @default(false)
  apertura  String?
  cierre    String?

  @@map("horario_dia")
}

model Configuracion {
  id                    Int      @id @default(1)
  inicioNoche           String   @default("18:00") @map("inicio_noche")
  tiempoLimitePagoMin   Int      @default(15) @map("tiempo_limite_pago_min")
  minutosAntesCheckIn   Int      @default(30) @map("minutos_antes_check_in")
  toleranciaAusenciaMin Int      @default(15) @map("tolerancia_ausencia_min")
  actualizadoEn         DateTime @updatedAt @map("actualizado_en")

  @@map("configuracion")
}

model Bloqueo {
  id            Int      @id @default(autoincrement())
  canchaId      Int      @map("cancha_id")
  inicio        DateTime
  fin           DateTime
  motivo        String
  creadoPorId   Int      @map("creado_por_id")
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  cancha    Cancha  @relation(fields: [canchaId], references: [id])
  creadoPor Usuario @relation(fields: [creadoPorId], references: [id])

  @@index([canchaId, inicio, fin])
  @@map("bloqueo")
}

model ReglaCancelacion {
  id                Int              @id @default(1)
  horasAnticipacion Int              @default(24) @map("horas_anticipacion")
  tipoCompensacion  TipoCompensacion @default(CREDITO) @map("tipo_compensacion")
  actualizadoEn     DateTime         @updatedAt @map("actualizado_en")

  @@map("regla_cancelacion")
}

model Adicional {
  id            Int      @id @default(autoincrement())
  nombre        String
  precio        Decimal  @db.Decimal(10, 2)
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now()) @map("creado_en")
  actualizadoEn DateTime @updatedAt @map("actualizado_en")

  consumos ConsumoAdicional[]

  @@map("adicional")
}

// Reservas

model Reserva {
  id                     Int              @id @default(autoincrement())
  codigo                 String           @unique
  jugadorId              Int              @map("jugador_id")
  creadoPorId            Int              @map("creado_por_id")
  origen                 OrigenReserva    @default(PLATAFORMA)
  canchaId               Int              @map("cancha_id")
  fecha                  DateTime         @db.Date
  horaInicio             String           @map("hora_inicio")
  horaFin                String           @map("hora_fin")
  inicioEn               DateTime         @map("inicio_en")
  finEn                  DateTime         @map("fin_en")
  franja                 Franja
  valorTurno             Decimal          @map("valor_turno") @db.Decimal(10, 2)
  adelantoMinimo         Decimal          @map("adelanto_minimo") @db.Decimal(10, 2)
  estado                 EstadoReserva    @default(PENDIENTE_PAGO)
  venceEn                DateTime?        @map("vence_en")
  reglaHorasAnticipacion Int              @map("regla_horas_anticipacion")
  reglaTipoCompensacion  TipoCompensacion @map("regla_tipo_compensacion")
  confirmadaEn           DateTime?        @map("confirmada_en")
  checkInEn              DateTime?        @map("check_in_en")
  finalizadaEn           DateTime?        @map("finalizada_en")
  ausenteEn              DateTime?        @map("ausente_en")
  canceladaEn            DateTime?        @map("cancelada_en")
  expiradaEn             DateTime?        @map("expirada_en")
  creadoEn               DateTime         @default(now()) @map("creado_en")
  actualizadoEn          DateTime         @updatedAt @map("actualizado_en")

  jugador       Usuario            @relation("ReservaJugador", fields: [jugadorId], references: [id])
  creadoPor     Usuario            @relation("ReservaCreadaPor", fields: [creadoPorId], references: [id])
  cancha        Cancha             @relation(fields: [canchaId], references: [id])
  pagos         Pago[]
  consumos      ConsumoAdicional[]
  cancelacion   Cancelacion?
  reubicaciones Reubicacion[]

  @@index([fecha, canchaId])
  @@index([jugadorId, estado])
  @@index([estado, venceEn])
  @@map("reserva")
}

// Pagos y adicionales

model Pago {
  id                Int          @id @default(autoincrement())
  reservaId         Int          @map("reserva_id")
  concepto          ConceptoPago
  canal             CanalPago
  metodo            MetodoPago
  monto             Decimal      @db.Decimal(10, 2)
  estado            EstadoPago
  numeroOperacion   String?      @map("numero_operacion")
  comprobanteUrl    String?      @map("comprobante_url")
  codigoTransaccion String?      @unique @map("codigo_transaccion")
  respuestaPasarela Json?        @map("respuesta_pasarela")
  registradoPorId   Int          @map("registrado_por_id")
  validadoPorId     Int?         @map("validado_por_id")
  validadoEn        DateTime?    @map("validado_en")
  motivoRechazo     String?      @map("motivo_rechazo")
  cierreCajaId      Int?         @map("cierre_caja_id")
  creadoEn          DateTime     @default(now()) @map("creado_en")
  actualizadoEn     DateTime     @updatedAt @map("actualizado_en")

  reserva       Reserva            @relation(fields: [reservaId], references: [id])
  registradoPor Usuario            @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id])
  validadoPor   Usuario?           @relation("PagoValidadoPor", fields: [validadoPorId], references: [id])
  cierreCaja    CierreCaja?        @relation(fields: [cierreCajaId], references: [id])
  creditoUsos   CreditoUso[]
  consumos      ConsumoAdicional[]

  @@index([reservaId, concepto, estado])
  @@index([registradoPorId, cierreCajaId])
  @@map("pago")
}

model ConsumoAdicional {
  id              Int      @id @default(autoincrement())
  reservaId       Int      @map("reserva_id")
  adicionalId     Int      @map("adicional_id")
  nombre          String
  precioUnitario  Decimal  @map("precio_unitario") @db.Decimal(10, 2)
  cantidad        Int
  subtotal        Decimal  @db.Decimal(10, 2)
  pagoId          Int?     @map("pago_id")
  registradoPorId Int      @map("registrado_por_id")
  creadoEn        DateTime @default(now()) @map("creado_en")
  actualizadoEn   DateTime @updatedAt @map("actualizado_en")

  reserva       Reserva   @relation(fields: [reservaId], references: [id])
  adicional     Adicional @relation(fields: [adicionalId], references: [id])
  pago          Pago?     @relation(fields: [pagoId], references: [id])
  registradoPor Usuario   @relation(fields: [registradoPorId], references: [id])

  @@index([reservaId])
  @@map("consumo_adicional")
}

// Cancelaciones, devoluciones y créditos

model Cancelacion {
  id                  Int                  @id @default(autoincrement())
  reservaId           Int                  @unique @map("reserva_id")
  canceladaPorId      Int                  @map("cancelada_por_id")
  motivo              MotivoCancelacion
  detalleMotivo       String?              @map("detalle_motivo")
  adelantoPagado      Decimal              @map("adelanto_pagado") @db.Decimal(10, 2)
  resultado           ResultadoCancelacion
  importeCompensacion Decimal              @map("importe_compensacion") @db.Decimal(10, 2)
  importeRetenido     Decimal              @map("importe_retenido") @db.Decimal(10, 2)
  estadoCompensacion  EstadoCompensacion   @map("estado_compensacion")
  creadoEn            DateTime             @default(now()) @map("creado_en")

  reserva      Reserva      @relation(fields: [reservaId], references: [id])
  canceladaPor Usuario      @relation(fields: [canceladaPorId], references: [id])
  devoluciones Devolucion[]
  creditos     Credito[]

  @@index([estadoCompensacion])
  @@map("cancelacion")
}

model Devolucion {
  id              Int        @id @default(autoincrement())
  cancelacionId   Int        @map("cancelacion_id")
  monto           Decimal    @db.Decimal(10, 2)
  metodo          MetodoPago
  numeroOperacion String?    @map("numero_operacion")
  registradoPorId Int        @map("registrado_por_id")
  cierreCajaId    Int?       @map("cierre_caja_id")
  creadoEn        DateTime   @default(now()) @map("creado_en")

  cancelacion   Cancelacion @relation(fields: [cancelacionId], references: [id])
  registradoPor Usuario     @relation(fields: [registradoPorId], references: [id])
  cierreCaja    CierreCaja? @relation(fields: [cierreCajaId], references: [id])

  @@index([registradoPorId, cierreCajaId])
  @@map("devolucion")
}

model Credito {
  id              Int      @id @default(autoincrement())
  jugadorId       Int      @map("jugador_id")
  monto           Decimal  @db.Decimal(10, 2)
  saldo           Decimal  @db.Decimal(10, 2)
  cancelacionId   Int?     @map("cancelacion_id")
  habilitadoPorId Int?     @map("habilitado_por_id")
  creadoEn        DateTime @default(now()) @map("creado_en")

  jugador       Usuario      @relation("CreditoJugador", fields: [jugadorId], references: [id])
  habilitadoPor Usuario?     @relation("CreditoHabilitadoPor", fields: [habilitadoPorId], references: [id])
  cancelacion   Cancelacion? @relation(fields: [cancelacionId], references: [id])
  usos          CreditoUso[]

  @@index([jugadorId])
  @@map("credito")
}

model CreditoUso {
  id        Int     @id @default(autoincrement())
  creditoId Int     @map("credito_id")
  pagoId    Int     @map("pago_id")
  monto     Decimal @db.Decimal(10, 2)

  credito Credito @relation(fields: [creditoId], references: [id])
  pago    Pago    @relation(fields: [pagoId], references: [id])

  @@index([creditoId])
  @@index([pagoId])
  @@map("credito_uso")
}

model Reubicacion {
  id               Int      @id @default(autoincrement())
  reservaId        Int      @map("reserva_id")
  canchaAnteriorId Int      @map("cancha_anterior_id")
  canchaNuevaId    Int      @map("cancha_nueva_id")
  motivo           String
  registradoPorId  Int      @map("registrado_por_id")
  creadoEn         DateTime @default(now()) @map("creado_en")

  reserva        Reserva @relation(fields: [reservaId], references: [id])
  canchaAnterior Cancha  @relation("ReubicacionCanchaAnterior", fields: [canchaAnteriorId], references: [id])
  canchaNueva    Cancha  @relation("ReubicacionCanchaNueva", fields: [canchaNuevaId], references: [id])
  registradoPor  Usuario @relation(fields: [registradoPorId], references: [id])

  @@index([reservaId])
  @@map("reubicacion")
}

// Caja

model CierreCaja {
  id               Int             @id @default(autoincrement())
  recepcionistaId  Int             @map("recepcionista_id")
  cerradoEn        DateTime        @default(now()) @map("cerrado_en")
  totales          Json
  efectivoEsperado Decimal         @map("efectivo_esperado") @db.Decimal(10, 2)
  efectivoContado  Decimal         @map("efectivo_contado") @db.Decimal(10, 2)
  diferencia       Decimal         @db.Decimal(10, 2)
  resultado        ResultadoCierre
  observacion      String?

  recepcionista Usuario          @relation(fields: [recepcionistaId], references: [id])
  pagos         Pago[]
  devoluciones  Devolucion[]
  correcciones  CorreccionCaja[]

  @@index([recepcionistaId, cerradoEn])
  @@map("cierre_caja")
}

model CorreccionCaja {
  id       Int      @id @default(autoincrement())
  cierreId Int      @map("cierre_id")
  adminId  Int      @map("admin_id")
  motivo   String
  detalle  Json
  creadoEn DateTime @default(now()) @map("creado_en")

  cierre CierreCaja @relation(fields: [cierreId], references: [id])
  admin  Usuario    @relation(fields: [adminId], references: [id])

  @@map("correccion_caja")
}
